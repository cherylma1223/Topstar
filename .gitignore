node_modules/
.DS_Store

# 本地配置文件，不提交
.env.example
CLAUDE.md.local
server/.gitignore
.env
dist/
.trash/
*.log
backups/
temp_update/
old_env_check/
# 用户上传的视频文件（Phase 2-A）
server/uploads/*
!server/uploads/.gitkeep

# SQLite 数据库文件（本地运行产生，不提交）
*.db
*.db-shm
*.db-wal
.agents/

# 评测集视频（体积大，不提交；标注表 eval/labels 和评测结果 eval/runs 会提交）
eval/videos/*
!eval/videos/.gitkeep

# 标注工具（npm run labeler）每次保存前自动留的上一版备份
eval/labels/*.bak
